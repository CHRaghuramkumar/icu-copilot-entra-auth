# Copy to auth-service/.env. `npm run start:dev` and `npm start` load it automatically.

NODE_ENV=development
PORT=4100

# Browser origins that may call this service with cookies (comma separated).
WEB_ORIGINS=http://localhost:3000

# --- Microsoft Entra ID -------------------------------------------------------
# The hospital's single tenant id. "common"/"organizations" are refused.
ENTRA_TENANT_ID=11111111-1111-1111-1111-111111111111
# Real Entra: https://login.microsoftonline.com (the default). Local emulator: https://localhost:8443
ENTRA_AUTHORITY_ORIGIN=https://localhost:8443
# This service's own app registration: its client id, and optionally its App ID URI (comma separated).
# Local emulator: the seeded "local-api" app.
ENTRA_API_AUDIENCE=cccccccc-0000-0000-0000-000000000007,api://cccccccc-0000-0000-0000-000000000007
ENTRA_REQUIRED_SCOPE=access_as_user
# Local emulator only: trust its self-signed certificate for the JWKS download. Leave empty for real Entra.
ENTRA_CA_CERT_PATH=../.entra-local-data/tls/cert.pem
# Optional overrides (normally derived from the two values above):
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys

# --- Tokens this service issues -----------------------------------------------
TOKEN_ISSUER=http://localhost:4100
TOKEN_AUDIENCE=icu-copilot
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
# PKCS#8 PEM, required in production. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out signing-key.pem
# and pass the file contents (newlines may be written as \n). Empty in dev = temporary key per restart.
TOKEN_SIGNING_PRIVATE_KEY=
TOKEN_SIGNING_KEY_ID=icu-copilot-auth-1

# --- Refresh cookie ------------------------------------------------------------
REFRESH_COOKIE_NAME=icu_copilot_rt
# Defaults to true when NODE_ENV=production.
REFRESH_COOKIE_SECURE=false

# --- Users ---------------------------------------------------------------------
# Dev/demo user list. The production directory will read users from the EMR backend
# (see docs/emr-backend-integration.md).
USERS_FILE=config/users.dev.json
