# Copy to web/.env.local. These values are public (they go into the browser bundle).

# --- Local emulator (entra-local, seeded apps) -------------------------------
NEXT_PUBLIC_ENTRA_AUTHORITY=https://localhost:8443/11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_ENTRA_KNOWN_AUTHORITY=localhost:8443
# Seeded "local-web-client" (SPA, redirect http://localhost:3000)
NEXT_PUBLIC_ENTRA_CLIENT_ID=cccccccc-0000-0000-0000-000000000006
# Seeded "local-api" exposes access_as_user and puts email in its access tokens
NEXT_PUBLIC_ENTRA_API_SCOPE=api://cccccccc-0000-0000-0000-000000000007/access_as_user

# --- Real Entra ID (hospital tenant) -----------------------------------------
# NEXT_PUBLIC_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
# NEXT_PUBLIC_ENTRA_KNOWN_AUTHORITY=           (leave empty for Microsoft)
# NEXT_PUBLIC_ENTRA_CLIENT_ID=<web app registration client id>
# NEXT_PUBLIC_ENTRA_API_SCOPE=api://<auth service app registration id>/access_as_user

NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4100
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
